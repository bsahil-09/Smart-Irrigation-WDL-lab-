<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farmer Registration - Smart Irrigation Advisory System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f7f0;
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 700px;
            margin: auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #2e7d32;
        }

        fieldset {
            margin-bottom: 20px;
            padding: 20px;
            border: 1px solid #aaa;
            border-radius: 8px;
        }

        legend {
            font-weight: bold;
            color: #2e7d32;
        }

        label {
            display: block;
            margin-top: 12px;
            margin-bottom: 5px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid #aaa;
            border-radius: 5px;
        }

        input[type="file"] {
            border: none;
        }

        .buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        button {
            padding: 10px 25px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        .submit-btn {
            background-color: #2e7d32;
            color: white;
        }

        .reset-btn {
            background-color: #777;
            color: white;
        }

        button:hover {
            opacity: 0.85;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Farmer Registration</h1>

        <form id="farmerRegistrationForm" name="farmerRegistrationForm">

            <!-- Farmer Information -->
            <fieldset>
                <legend>Farmer Information</legend>

                <label for="farmerName">Farmer Name:</label>
                <input type="text" id="farmerName" name="farmerName">

                <label for="mobileNumber">Mobile Number:</label>
                <input type="tel" id="mobileNumber" name="mobileNumber">

                <label for="email">Email:</label>
                <input type="email" id="email" name="email">

                <label for="village">Village:</label>
                <input type="text" id="village" name="village">

            </fieldset>

            <!-- Farm Information -->
            <fieldset>
                <legend>Farm Information</legend>

                <label for="plotId">Plot ID:</label>
                <input type="text" id="plotId" name="plotId">

                <label for="cropStage">Crop Stage:</label>
                <select id="cropStage" name="cropStage">
                    <option value="">-- Select Crop Stage --</option>
                    <option value="sowing">Sowing</option>
                    <option value="germination">Germination</option>
                    <option value="vegetative">Vegetative</option>
                    <option value="flowering">Flowering</option>
                    <option value="maturity">Maturity</option>
                    <option value="harvesting">Harvesting</option>
                </select>

                <label for="soilType">Soil Type:</label>
                <select id="soilType" name="soilType">
                    <option value="">-- Select Soil Type --</option>
                    <option value="sandy">Sandy</option>
                    <option value="clay">Clay</option>
                    <option value="loamy">Loamy</option>
                    <option value="silty">Silty</option>
                    <option value="black">Black Soil</option>
                    <option value="red">Red Soil</option>
                </select>

                <label for="irrigationMethod">Irrigation Method:</label>
                <select id="irrigationMethod" name="irrigationMethod">
                    <option value="">-- Select Irrigation Method --</option>
                    <option value="drip">Drip Irrigation</option>
                    <option value="sprinkler">Sprinkler Irrigation</option>
                    <option value="flood">Flood Irrigation</option>
                    <option value="furrow">Furrow Irrigation</option>
                </select>

                <label for="soilMoisture">Soil Moisture (%):</label>
                <input type="number" id="soilMoisture" name="soilMoisture" min="0" max="100" step="0.1">

                <label for="registrationDate">Registration Date:</label>
                <input type="date" id="registrationDate" name="registrationDate">

                <label for="farmPhoto">Farm Photo:</label>
                <input type="file" id="farmPhoto" name="farmPhoto" accept="image/*">

            </fieldset>

            <!-- Buttons -->
            <div class="buttons">
                <button type="submit" class="submit-btn">Submit</button>
                <button type="reset" class="reset-btn">Reset</button>
            </div>

        </form>

    </div>

</body>

</html>